LEAD_WEBHOOK_URL=

# Google Tag Manager / Analytics / Ads (Opcional - deixe vazio se injetar via GTM)
GTM_ID=
GA4_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
